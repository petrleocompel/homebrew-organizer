{
	"name": "homebrew-organizer",
	"version": "0.1.0",
	"private": true,
	"description": "Self-hosted organizer for homebrew recipes, batches, reusable bottles, and QR labels.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/petrleocompel/homebrew-organizer.git"
	},
	"type": "module",
	"scripts": {
		"build": "next build",
		"build:scripts": "esbuild src/scripts/migrate.ts src/scripts/seed-admin.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist --out-extension:.js=.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
		"check": "biome check .",
		"check:unsafe": "biome check --write --unsafe .",
		"check:write": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/scripts/migrate.ts",
		"db:migration-preflight": "tsx src/scripts/migration-preflight.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dev": "next dev --turbo",
		"preview": "next build && next start",
		"start": "next start",
		"db:seed-admin": "tsx src/scripts/seed-admin.ts",
		"typecheck": "tsc --noEmit",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:install": "playwright install chromium",
		"test:e2e:prepare": "tsx src/scripts/prepare-playwright.ts",
		"test:e2e:ui": "playwright test --ui",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest"
	},
	"dependencies": {
		"@beerjson/beerjson": "^1.0.2",
		"@fontsource/noto-sans": "^5.3.0",
		"@hookform/resolvers": "^5.9.1",
		"@pdf-lib/fontkit": "^1.1.1",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-aspect-ratio": "^1.1.15",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-context-menu": "^2.3.7",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-hover-card": "^1.1.23",
