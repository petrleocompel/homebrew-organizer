		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	},
	"ct3aMetadata": {
		"initVersion": "7.39.3"
	},
	"overrides": {
		"defu": "^6.1.7",
		"postcss": "^8.5.28",
		"sharp": "^0.35.3"
	},
	"packageManager": "pnpm@10.33.0"
}
