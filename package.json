		"tailwindcss-animate": "^1.0.7",
		"vaul": "^1.1.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.63.0",
