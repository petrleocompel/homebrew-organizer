		"better-auth": "^1.7.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "4.4.0",
		"drizzle-orm": "^0.45.3",
		"embla-carousel-react": "^8.6.0",
		"fast-xml-parser": "^5.11.2",
