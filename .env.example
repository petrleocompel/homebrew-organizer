# Copy to .env for local development or for compose.yaml. Never commit real values.

# Public origin of this instance. Used for QR codes, links, and authentication.
PUBLIC_APP_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
# Optional: authentication origin when it differs from PUBLIC_APP_URL.
# BETTER_AUTH_URL="http://localhost:3000"
# Optional: comma-separated QR hosts accepted by the scanner. Defaults to the PUBLIC_APP_URL host.
# ALLOWED_QR_HOSTS="brew.example.com,localhost"

# Database (POSTGRES_* are read by compose.yaml; start-database.sh reads DATABASE_URL)
POSTGRES_USER="app"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="app"
DATABASE_URL="postgresql://app:CHANGE_ME@localhost:5432/app"

# Optional: upload limits in bytes
# RECIPE_UPLOAD_MAX_BYTES="5242880"
# PDF_UPLOAD_MAX_BYTES="10485760"

# Optional: operator details shown on the public footer, privacy, and support pages
# OPERATOR_NAME="Example Brewery"
# SUPPORT_EMAIL="support@example.com"

# Optional: iOS Universal Links (/.well-known/apple-app-site-association is served only when both are set)
# APPLE_TEAM_ID="ABCDE12345"
# APPLE_BUNDLE_ID="com.example.homebrew-scan"

# Bootstrap Owner for `pnpm db:seed-admin`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME"

# Playwright E2E (dedicated disposable database)
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
PLAYWRIGHT_DATABASE_URL="postgresql://app:CHANGE_ME@localhost:5432/homebrew-organizer_playwright"
