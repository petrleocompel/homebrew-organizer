# Copy this file to .env for local development. Never commit real values.

# Authentication
BETTER_AUTH_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
BETTER_AUTH_URL="http://127.0.0.1:3000"
PUBLIC_APP_URL="http://127.0.0.1:3000"
ALLOWED_QR_HOSTS="brew.example.com,127.0.0.1,localhost"

# Database
POSTGRES_USER="app"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="app"
DATABASE_URL="postgresql://app:CHANGE_ME@localhost:5432/app"

# Upload limits (bytes)
RECIPE_UPLOAD_MAX_BYTES="5242880"
PDF_UPLOAD_MAX_BYTES="10485760"

# Universal Links (locked production identity)
APPLE_TEAM_ID="ABCDE12345"
APPLE_BUNDLE_ID="com.example.homebrew-scan"

# Playwright E2E (dedicated disposable database)
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
PLAYWRIGHT_DATABASE_URL="postgresql://app:CHANGE_ME@localhost:5432/homebrew-organizer_playwright"
