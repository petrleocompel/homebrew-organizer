# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# better-auth
# You can generate a new secret with:
# npx auth secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://127.0.0.1:3000"
PUBLIC_APP_URL="http://127.0.0.1:3000"
ALLOWED_QR_HOSTS="brew.example.com,127.0.0.1,localhost"


# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/homebrew-organizer"

# Upload limits (bytes)
RECIPE_UPLOAD_MAX_BYTES="5242880"
PDF_UPLOAD_MAX_BYTES="10485760"

# Universal Links (production)
APPLE_TEAM_ID=""
APPLE_BUNDLE_ID="com.example.HomebrewScan"

# Playwright E2E
# Use a dedicated disposable database so the test suite never mutates your main dev data.
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
PLAYWRIGHT_DATABASE_URL="postgresql://postgres:password@localhost:5432/homebrew-organizer_playwright"
